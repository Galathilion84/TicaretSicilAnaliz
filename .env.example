# Çoğu kullanıcının bu dosyaya İHTİYACI YOKTUR.
# TSG e-postası/şifresi ve Gemini anahtarı uygulama içindeki "Hesap ve ayarlar" penceresinden girilir
# ve işletim sisteminin kimlik kasasında saklanır. Aşağıdakiler isteğe bağlı gelişmiş ayarlardır.
# Kullanmak için bu dosyayı ".env" olarak kopyalayın (".env" git'e eklenmez).

# Uygulamanın portu (varsayılan 8000)
# PORT=8000

# Kimlik kasası kullanılamıyorsa bilgiler buraya yazılır. Düz metindir, dikkatli olun.
# TSG_EMAIL=
# TSG_PASSWORD=
# GEMINI_API_KEY=

# Gemini model sırası (virgülle ayrılmış, ilk başarılı olan kullanılır)
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest

# Kurumsal SSL denetimi kullanan ağlarda: kurum CA dosyası (TLS doğrulamasını kapatmak yerine bunu verin)
# TSG_CA_BUNDLE=C:\path\to\kurum-ca.pem

# Önbellek sınırları
# PDF_CACHE_MAX_MB=500
# PDF_CACHE_TTL_DAYS=30
# MAX_PDF_MB=40
